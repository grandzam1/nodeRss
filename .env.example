# ============================================================
# Required for local development
# ============================================================

# --- Scraper provider ---
# Which backend fetches posts: brightdata | apify | crawlee
# (auto-detects if unset: apify when only APIFY_TOKEN is set, else brightdata)
SCRAPER_PROVIDER=

# Bright Data API key (only needed when SCRAPER_PROVIDER=brightdata)
BRIGHTDATA_API_KEY=

# Apify API token (only needed when SCRAPER_PROVIDER=apify)
APIFY_TOKEN=

# Crawlee + Playwright uses public browser-visible pages; no API key is used.

# --- Local server ---
# Port for `npm run ui` (default 3000)
PORT=3000

# ============================================================
# Required for production (Vercel / deployed)
# ============================================================

# --- Storage ---
# Where posts/profiles/settings are saved: sqlite | supabase | watch
# 'watch' uses the existing watch_* tables in your Supabase project.
# (auto-detects if unset: supabase when its keys exist, else sqlite)
# Local dev can leave this unset (sqlite). Production should use supabase.
STORAGE=

# Supabase credentials (required when STORAGE=supabase or watch)
# Project Settings > Data API > URL, and API Keys > service_role (or sb_secret key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# --- Job runner ---
# How scrape jobs execute: local | inngest | github-actions
# Keep Inngest as the production default. GitHub Actions is an optional worker.
JOB_RUNNER=

# Required when JOB_RUNNER=inngest — copy BOTH from the SAME Inngest
# environment (dashboard > your env > Keys). A pair from different
# environments means events are accepted but runs never start.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Admin / deployed API ---
# Bearer token required for ALL write endpoints in production
# (POST /api/profiles, DELETE /api/profiles/:id, PUT /api/settings, POST /api/run).
# If unset in production, writes fail closed with 503. Paste it into the UI
# when asked (kept in sessionStorage). Generate: node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=

# Bearer token that can call POST /api/run (scheduler/cron callers only).
# Does not unlock other write endpoints.
CRON_SECRET=

# --- Optional GitHub Actions runner (Vercel/API side) ---
# Use a fine-grained GitHub token scoped to this repo with Actions: write and Contents: read.
GITHUB_ACTIONS_TOKEN=
GITHUB_ACTIONS_REPOSITORY=grandzam1/nodeRss
GITHUB_ACTIONS_WORKFLOW=crawlee-worker.yml
# Must refer to a branch containing the worker workflow. Use a dev branch for development tests.
GITHUB_ACTIONS_REF=

# ============================================================
# Optional
# ============================================================

# Talk to a local Inngest dev server instead of Inngest Cloud (local dev only).
# Any truthy value uses http://localhost:8288; a full URL uses that base instead.
# No INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY needed when set.
# INNGEST_DEV=1

# Override the Inngest API base URL entirely (self-hosted Inngest).
# INNGEST_API_BASE_URL=

# Port for `npm run inngest:serve` (default 3001)
# INNGEST_PORT=3001

# DEPRECATED — only needed when JOB_RUNNER=trigger (replaced by inngest)
# TRIGGER_SECRET_KEY=
# TRIGGER_TASK_ID=
