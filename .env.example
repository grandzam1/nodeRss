# --- Scraper provider ---
# Which backend fetches posts: brightdata | apify
# (auto-detects if unset: apify when only APIFY_TOKEN is set, else brightdata)
SCRAPER_PROVIDER=apify

# Bright Data API key (only needed when SCRAPER_PROVIDER=brightdata)
BRIGHTDATA_API_KEY=

# Apify API token (only needed when SCRAPER_PROVIDER=apify)
APIFY_TOKEN=

# --- Storage ---
# Where posts/profiles/settings are saved: sqlite | supabase | watch
# 'watch' uses the existing watch_* tables in your Supabase project.
# (auto-detects if unset: watch when Supabase keys exist, else sqlite)
STORAGE=watch

# Supabase credentials (only needed when STORAGE=supabase or watch)
# Project Settings > Data API > URL, and API Keys > service_role (or sb_secret key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# --- Job runner ---
# How scrape jobs execute: local (in-process, default) | inngest (Inngest) | trigger (Trigger.dev, deprecated)
JOB_RUNNER=local

# Only needed when JOB_RUNNER=inngest (Inngest dashboard > Manage > Event keys / Signing key)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local development only: talk to a local Inngest dev server instead of Inngest Cloud
# INNGEST_DEV=1

# DEPRECATED — only needed when JOB_RUNNER=trigger (Trigger.dev project > API keys)
TRIGGER_SECRET_KEY=
TRIGGER_TASK_ID=scrape-posts

# --- Scheduler / deployed API ---
# Bearer token required to call POST /api/run on Vercel.
# Generate any random string, e.g.: node -e "console.log(crypto.randomUUID())"
CRON_SECRET=

# --- Local server ---
# Port for `npm run ui` (default 3000)
PORT=3000
