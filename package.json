{
  "name": "social-post-scraper",
  "version": "1.0.0",
  "description": "Fetch recent social posts via Bright Data or Apify and save new ones to Supabase.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/index.js",
    "ui": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/server.js",
    "posts": "node --no-warnings=ExperimentalWarning src/list.js",
    "inngest:serve": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/inngest/serve.js",
    "github-actions:worker": "node src/jobs/github-actions-worker.js",
    "build": "tailwindcss -i src/styles.css -o public/styles.css --minify",
    "build:css": "tailwindcss -i src/styles.css -o public/styles.css --watch",
    "test": "node --test --experimental-test-module-mocks --no-warnings=ExperimentalWarning test/*.test.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@trigger.dev/sdk": "4.8.3",
    "crawlee": "^3.18.2",
    "inngest": "^4.26.2",
    "playwright": "^1.65.0"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.8.3",
    "tailwindcss": "^3.4.19"
  }
}
